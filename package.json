{
  "name": "@ai-zen/cli",
  "version": "1.0.2",
  "description": "AI-ZEN CLI - dual-mode AI terminal: pure stdio pipelines and an interactive TUI",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "bin": {
    "ai": "dist/index.js",
    "aiz": "dist/index.js",
    "zen": "dist/index.js"
  },
  "scripts": {
    "clean": "rimraf ./dist",
    "prebuild": "npm run clean",
    "build": "tsc",
    "start": "npm run build && node ./dist/index.js",
    "prepublishOnly": "node scripts/check-publish.mjs && npm run test:all",
    "pretest": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:e2e": "npm run pretest && npm run build && vitest run --config vitest.e2e.config.ts",
    "test:all": "npm run pretest && vitest run && npm run build && vitest run --config vitest.e2e.config.ts",
    "format": "prettier --write --ignore-path .prettierignore \"src/**/*.{ts,tsx,js,mjs,cjs,json}\" \"scripts/**/*.{mjs,js,cjs}\" \"*.{ts,js,mjs,cjs,json}\"",
    "format:check": "prettier --check --ignore-path .prettierignore \"src/**/*.{ts,tsx,js,mjs,cjs,json}\" \"scripts/**/*.{mjs,js,cjs}\" \"*.{ts,js,mjs,cjs,json}\""
  },
  "keywords": [
    "ai",
    "agent",
    "cli",
    "llm",
    "chat",
    "autonomous-agent"
  ],
  "author": "LZQCN",
  "license": "MIT",
  "dependencies": {
    "@ai-zen/agents-client": "link:../agents/packages/client",
    "@ai-zen/agents-core": "^4.5.5",
    "@ai-zen/agents-sdk": "link:../agents/packages/sdk",
    "@ai-zen/agents-server": "link:../agents/packages/server",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "dayjs": "^1.11.21",
    "highlight.js": "^11.12.0",
    "ink": "^7.1.1",
    "lowlight": "^3.3.0",
    "react": "^19.3.0",
    "string-width": "^8.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@ai-zen/agents-testing": "link:../agents/packages/testing",
    "@types/hast": "^3.0.5",
    "@types/node": "^24.12.2",
    "@types/react": "^19.3.0",
    "dotenv": "^17.4.2",
    "ink-testing-library": "^4.0.0",
    "rimraf": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0",
    "prettier": "^3.9.5"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ]
}
