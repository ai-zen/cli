{
  "name": "@ai-zen/cli",
  "version": "1.0.0-alpha.1",
  "description": "AI-ZEN CLI - dual-mode AI terminal: pure stdio pipelines and an interactive TUI",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "bin": {
    "ai": "dist/index.js",
    "aiz": "dist/index.js",
    "zen": "dist/index.js"
  },
  "scripts": {
    "clean": "rimraf ./dist",
    "prebuild": "npm run clean",
    "build": "tsc",
    "start": "npm run build && node ./dist/index.js",
    "prepublishOnly": "node scripts/check-publish-tool.mjs && npm test && npm run build",
    "pretest": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:e2e": "npm run pretest && npm run build && vitest run --config vitest.e2e.config.ts",
    "test:all": "npm run pretest && vitest run && npm run build && vitest run --config vitest.e2e.config.ts"
  },
  "keywords": [
    "ai",
    "agent",
    "cli",
    "llm",
    "chat",
    "autonomous-agent"
  ],
  "author": "LZQCN",
  "license": "MIT",
  "dependencies": {
    "@ai-zen/agents-core": "^4.3.0",
    "@ai-zen/agents-sdk": "1.0.0-alpha.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "dayjs": "^1.11.21",
    "highlight.js": "^11.12.0",
    "ink": "^7.1.1",
    "lowlight": "^3.3.0",
    "react": "^19.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/hast": "^3.0.5",
    "@types/node": "^24.12.2",
    "@types/react": "^19.3.0",
    "dotenv": "^17.4.2",
    "ink-testing-library": "^4.0.0",
    "rimraf": "^6.0.0",
    "typescript": "^5.3.3",
    "vitest": "^4.1.9"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ]
}
